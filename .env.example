PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret

# Supabase PostgreSQL connection string.
# For Vercel, copy the transaction pooler URI from Supabase Connect.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?sslmode=require
# Optional: paste the Supabase root certificate from Database Settings to verify the server certificate.
DATABASE_SSL_CA=
# Only for trusted local PostgreSQL servers without TLS.
# DATABASE_SSL=disable

# Email Configuration
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
