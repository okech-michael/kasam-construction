PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret

# Supabase PostgreSQL connection string.
# Copy the pooler connection string from Supabase; keep sslmode=require.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?sslmode=require
# For a trusted local PostgreSQL server without TLS only, set DATABASE_SSL=disable.

# Email Configuration
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
