<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Ka'sam Construction Enterprise – Building the Future with Excellence. Professional construction, renovation, and infrastructure services in Kenya." />
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Ka\'sam Construction Enterprise' %></title>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Barlow:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

  <!-- Stylesheet -->
  <link rel="stylesheet" href="/static/css/style.css" />

  <% if (typeof extraCSS !== 'undefined' && extraCSS) { %>
    <%- extraCSS %>
  <% } %>
</head>
<body>

<!-- ── Navigation ──────────────────────────────────────────── -->
<nav id="navbar">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <div class="nav-logo-icon">KCE</div>
      <div class="nav-logo-text">
        <span class="nav-logo-name">Ka'sam Construction</span>
        <span class="nav-logo-tagline">Enterprise</span>
      </div>
    </a>

    <ul class="nav-links">
      <li><a href="/">Home</a></li>
      <li><a href="/services">Services</a></li>
      <li><a href="/projects">Projects</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/contact" class="nav-cta">Book Consultation</a></li>
    </ul>

    <button class="hamburger" id="hamburger" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<!-- Mobile Menu -->
<div class="mobile-menu" id="mobileMenu">
  <a href="/">Home</a>
  <a href="/services">Services</a>
  <a href="/projects">Projects</a>
  <a href="/about">About &amp; Team</a>
  <a href="/contact" class="nav-cta">Book Consultation</a>
</div>

<!-- Messages -->
<% if (typeof messages !== 'undefined' && messages && messages.length > 0) { %>
<div class="django-messages">
  <% messages.forEach(function(message) { %>
  <div class="alert-msg <%= message.type === 'success' ? 'alert-success' : 'alert-error' %>">
    <i class="fa-solid <%= message.type === 'success' ? 'fa-circle-check' : 'fa-circle-exclamation' %>"></i>
    <%= message.text %>
  </div>
  <% }); %>
</div>
<% } %>

<!-- Main content -->
<%- body %>

<!-- ── Footer ─────────────────────────────────────────────── -->
<footer>
  <div class="footer-main">
    <div class="container">
      <div class="footer-grid">
        <!-- Brand -->
        <div>
          <div class="footer-logo-wrap">
            <a href="/" class="nav-logo" style="display:inline-flex;">
              <div class="nav-logo-icon">KCE</div>
              <div class="nav-logo-text">
                <span class="nav-logo-name">Ka'sam Construction</span>
                <span class="nav-logo-tagline">Enterprise</span>
              </div>
            </a>
          </div>
          <p class="footer-about">Building the future with excellence, integrity, and precision. Kenya's trusted partner for construction, renovation, and infrastructure development.</p>
          <div class="footer-socials">
            <a href="#" class="footer-social" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
            <a href="#" class="footer-social" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
            <a href="#" class="footer-social" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
            <a href="#" class="footer-social" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
          </div>
        </div>

        <!-- Quick Links -->
        <div class="footer-col">
          <h4>Quick Links</h4>
          <ul class="footer-links">
            <li><a href="/">Home</a></li>
            <li><a href="/services">Our Services</a></li>
            <li><a href="/projects">Projects</a></li>
            <li><a href="/about">About Us</a></li>
            <li><a href="/contact">Contact Us</a></li>
            <li><a href="/contact">Book Consultation</a></li>
          </ul>
        </div>

        <!-- Services -->
        <div class="footer-col">
          <h4>Services</h4>
          <ul class="footer-links">
            <li><a href="/services">General Construction</a></li>
            <li><a href="/services">Design &amp; Planning</a></li>
            <li><a href="/services">Project Management</a></li>
            <li><a href="/services">Renovation &amp; Remodeling</a></li>
            <li><a href="/services">MEP Services</a></li>
            <li><a href="/services">Civil Works</a></li>
          </ul>
        </div>

        <!-- Contact -->
        <div class="footer-col">
          <h4>Contact Us</h4>
          <div class="footer-contact-item">
            <i class="fas fa-phone"></i>
            <a href="tel:0714712531">0714 712 531</a>
          </div>
          <div class="footer-contact-item">
            <i class="fas fa-envelope"></i>
            <a href="mailto:info@kasamenterprises.co.ke">info@kasamenterprises.co.ke</a>
          </div>
          <div class="footer-contact-item">
            <i class="fas fa-map-marker-alt"></i>
            <span>Nyamasaria Shopping Centre, Kisumu, Kenya</span>
          </div>
          <div class="footer-contact-item">
            <i class="fas fa-clock"></i>
            <span>Mon – Sat: 7:00 AM – 6:00 PM</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
      <span>&copy; <%= new Date().getFullYear() %> Ka'sam Construction Enterprise. All rights reserved.</span>
      <span>Built with precision &amp; excellence in Kenya.</span>
    </div>
  </div>
</footer>

<script src="/static/js/main.js" defer></script>
<% if (typeof extraJS !== 'undefined' && extraJS) { %>
  <%- extraJS %>
<% } %>
</body>
</html>
