<!-- ── PAGE HERO ─────────────────────────────────────────────── -->
<section class="page-hero">
  <div class="container page-hero-inner">
    <div class="breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <span style="color:rgba(255,255,255,.8);">About Us</span>
    </div>
    <h1>About Ka'sam Construction Enterprise</h1>
    <p>Learn about Ka'sam Construction Enterprise and the construction services offered in Kisumu, Kenya.</p>
  </div>
</section>


<!-- ── COMPANY STORY ─────────────────────────────────────────── -->
<section class="company-story section-pad">
  <div class="container">
    <div class="story-grid">
      <div class="reveal-left">
        <span class="section-label">Our Story</span>
        <h2 class="section-title">Built on Trust, Driven by Excellence</h2>
        <div class="divider"></div>
        <p style="color:var(--text-body);margin-bottom:18px;line-height:1.78;font-size:.97rem;">
          Ka'sam Construction Enterprise is based in Kisumu, Kenya. The company offers construction,
          renovation, design, and infrastructure services for clients to discuss with the team.
        </p>
        <p style="color:var(--text-body);margin-bottom:28px;line-height:1.78;font-size:.97rem;">
          Contact us to discuss your project scope, requirements, and the services that may be suitable.
        </p>

        <div class="values-grid">
          <div class="value-item">
            <h4>Our Mission</h4>
            <p>To deliver exceptional construction solutions that transform communities and create lasting value for our clients.</p>
          </div>
          <div class="value-item">
            <h4>Our Vision</h4>
            <p>To grow as a construction company recognized for quality and integrity.</p>
          </div>
          <div class="value-item">
            <h4>Integrity</h4>
            <p>We operate with complete honesty and transparency in all our dealings — with clients, partners, and staff.</p>
          </div>
          <div class="value-item">
            <h4>Excellence</h4>
            <p>We hold ourselves to the highest standards in every aspect of our work — from design to final handover.</p>
          </div>
        </div>
      </div>

      <div class="story-img-wrap reveal">
        <div class="story-img">
          <img src="/static/images/general-construction.jfif" alt="Ka'sam Construction Enterprise Team" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ── WHY CHOOSE US ─────────────────────────────────────────── -->
<section class="section-pad" style="background:var(--grey-bg);">
  <div class="container">
    <div class="section-header centered">
      <span class="section-label">Why Ka'sam?</span>
      <h2 class="section-title">Why Clients Choose Us</h2>
      <div class="divider centered"></div>
    </div>

    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;" class="why-grid">
      <div class="reveal" style="background:var(--white);border-radius:var(--radius-lg);padding:32px;box-shadow:var(--shadow-sm);border-top:4px solid var(--accent);">
        <div style="width:52px;height:52px;background:rgba(232,160,32,.12);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:1.3rem;margin-bottom:18px;">
          <i class="fas fa-folder-open"></i>
        </div>
        <h3 style="font-size:1.15rem;margin-bottom:10px;">Project Experience</h3>
        <p style="font-size:.9rem;color:var(--text-body);line-height:1.7;">Discuss your project requirements with our team to learn about relevant experience and examples of our work.</p>
      </div>
      <div class="reveal" style="background:var(--white);border-radius:var(--radius-lg);padding:32px;box-shadow:var(--shadow-sm);border-top:4px solid var(--navy);">
        <div style="width:52px;height:52px;background:rgba(11,31,58,.08);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;color:var(--navy);font-size:1.3rem;margin-bottom:18px;">
          <i class="fas fa-users-cog"></i>
        </div>
        <h3 style="font-size:1.15rem;margin-bottom:10px;">Project Coordination</h3>
        <p style="font-size:.9rem;color:var(--text-body);line-height:1.7;">Contact us to learn about the professionals and trades available for your project.</p>
      </div>
      <div class="reveal" style="background:var(--white);border-radius:var(--radius-lg);padding:32px;box-shadow:var(--shadow-sm);border-top:4px solid var(--accent);">
        <div style="width:52px;height:52px;background:rgba(232,160,32,.12);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:1.3rem;margin-bottom:18px;">
          <i class="fas fa-clock"></i>
        </div>
        <h3 style="font-size:1.15rem;margin-bottom:10px;">Project Planning</h3>
        <p style="font-size:.9rem;color:var(--text-body);line-height:1.7;">Discuss project schedules, milestones, and delivery requirements with our team.</p>
      </div>
      <div class="reveal" style="background:var(--white);border-radius:var(--radius-lg);padding:32px;box-shadow:var(--shadow-sm);border-top:4px solid var(--navy);">
        <div style="width:52px;height:52px;background:rgba(11,31,58,.08);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;color:var(--navy);font-size:1.3rem;margin-bottom:18px;">
          <i class="fas fa-shield-alt"></i>
        </div>
        <h3 style="font-size:1.15rem;margin-bottom:10px;">Safety Planning</h3>
        <p style="font-size:.9rem;color:var(--text-body);line-height:1.7;">Discuss site safety requirements and arrangements as part of your project planning.</p>
      </div>
      <div class="reveal" style="background:var(--white);border-radius:var(--radius-lg);padding:32px;box-shadow:var(--shadow-sm);border-top:4px solid var(--accent);">
        <div style="width:52px;height:52px;background:rgba(232,160,32,.12);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:1.3rem;margin-bottom:18px;">
          <i class="fas fa-hand-holding-usd"></i>
        </div>
        <h3 style="font-size:1.15rem;margin-bottom:10px;">Project Quotations</h3>
        <p style="font-size:.9rem;color:var(--text-body);line-height:1.7;">Request a project-specific quotation based on your scope and requirements.</p>
      </div>
      <div class="reveal" style="background:var(--white);border-radius:var(--radius-lg);padding:32px;box-shadow:var(--shadow-sm);border-top:4px solid var(--navy);">
        <div style="width:52px;height:52px;background:rgba(11,31,58,.08);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;color:var(--navy);font-size:1.3rem;margin-bottom:18px;">
          <i class="fas fa-leaf"></i>
        </div>
        <h3 style="font-size:1.15rem;margin-bottom:10px;">Materials &amp; Methods</h3>
        <p style="font-size:.9rem;color:var(--text-body);line-height:1.7;">Discuss material options, building methods, and sustainability requirements for your project.</p>
      </div>
    </div>
  </div>
</section>


<!-- ── TEAM ──────────────────────────────────────────────────── -->
<section class="team-section section-pad">
  <div class="container">
    <div class="section-header centered">
      <span class="section-label">The People</span>
      <h2 class="section-title">Meet Our Team</h2>
      <div class="divider centered"></div>
      <p class="section-sub">
        Learn more about the people currently listed in our team profiles.
      </p>
    </div>

    <div class="team-grid">
      <% if (typeof teamMembers !== 'undefined' && teamMembers && teamMembers.length > 0) { %>
        <% teamMembers.forEach(function(member) { %>
        <div class="team-card reveal">
          <div class="team-photo">
            <img src="<%= member.photo_url %>" alt="<%= member.name %>" loading="lazy" decoding="async" />
          </div>
          <div class="team-body">
            <h3><%= member.name %></h3>
            <div class="team-role"><%= member.role %></div>
            <% if (member.phone) { %>
              <div class="team-contact">📞 <%= member.phone %></div>
            <% } %>
            <p><%= member.bio || 'A dedicated professional contributing excellence to every Ka\'sam Construction Enterprise project.' %></p>
            <div class="team-socials">
              <% if (member.linkedin) { %>
              <a href="<%= member.linkedin %>" class="team-social-btn" target="_blank" rel="noopener noreferrer"><i class="fab fa-linkedin-in"></i></a>
              <% } %>
              <% if (member.email) { %>
              <a href="mailto:<%= member.email %>" class="team-social-btn"><i class="fas fa-envelope"></i></a>
              <% } %>
              <% if (member.phone) { %>
              <a href="tel:<%= member.phone %>" class="team-social-btn"><i class="fas fa-phone"></i></a>
              <% } %>
            </div>
          </div>
        </div>
        <% }); %>
      <% } else { %>
        <p class="content-empty-state">Team profiles are being updated. Please contact us for enquiries.</p>
      <% } %>
    </div>
  </div>
</section>


<!-- ── CTA ───────────────────────────────────────────────────── -->
<section class="cta-banner">
  <div class="container">
    <div class="cta-inner">
      <div class="cta-text">
        <h2>Join Our Growing Team</h2>
        <p>We are always looking for talented, passionate construction professionals to join Ka'sam Construction Enterprise. Get in touch to explore career opportunities.</p>
      </div>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-primary">
          <i class="fas fa-envelope"></i> Get In Touch
        </a>
        <a href="tel:0714712531" class="btn btn-outline">
          <i class="fas fa-phone"></i> 0714 712 531
        </a>
      </div>
    </div>
  </div>
</section>
