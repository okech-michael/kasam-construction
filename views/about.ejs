<!-- ── PAGE HERO ─────────────────────────────────────────────── -->
<section class="page-hero">
  <div class="container page-hero-inner">
    <div class="breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <span style="color:rgba(255,255,255,.8);">About Us</span>
    </div>
    <h1>About Ka'sam Construction Enterprise</h1>
    <p>A decade and a half of building Kenya's future — one project at a time. Learn who we are, what drives us, and the talented team behind every structure we build.</p>
  </div>
</section>


<!-- ── COMPANY STORY ─────────────────────────────────────────── -->
<section class="company-story section-pad">
  <div class="container">
    <div class="story-grid">
      <div class="reveal-left">
        <span class="section-label">Our Story</span>
        <h2 class="section-title">Built on Trust, Driven by Excellence</h2>
        <div class="divider"></div>
        <p style="color:var(--text-body);margin-bottom:18px;line-height:1.78;font-size:.97rem;">
          Ka'sam Construction Enterprise was founded with a single purpose: to deliver construction services
          that set a new standard for quality, reliability, and professionalism in Kenya.
          Starting as a small local contractor in Kisumu, we have grown into a full-service
          construction company with a portfolio spanning residential, commercial, industrial,
          and infrastructure projects across the country.
        </p>
        <p style="color:var(--text-body);margin-bottom:28px;line-height:1.78;font-size:.97rem;">
          Our growth has been built on repeat business and referrals — the highest form of
          client endorsement. Every project we undertake reflects our unwavering commitment
          to safety, quality craftsmanship, transparent communication, and delivering results
          that exceed expectations.
        </p>

        <div class="values-grid">
          <div class="value-item">
            <h4>Our Mission</h4>
            <p>To deliver exceptional construction solutions that transform communities and create lasting value for our clients.</p>
          </div>
          <div class="value-item">
            <h4>Our Vision</h4>
            <p>To be the most trusted and innovative construction company in East Africa, recognized for quality and integrity.</p>
          </div>
          <div class="value-item">
            <h4>Integrity</h4>
            <p>We operate with complete honesty and transparency in all our dealings — with clients, partners, and staff.</p>
          </div>
          <div class="value-item">
            <h4>Excellence</h4>
            <p>We hold ourselves to the highest standards in every aspect of our work — from design to final handover.</p>
          </div>
        </div>
      </div>

      <div class="story-img-wrap reveal">
        <div class="story-img">
          <img src="/static/images/general-construction.jfif" alt="Ka'sam Construction Enterprise Team" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ── WHY CHOOSE US ─────────────────────────────────────────── -->
<section class="section-pad" style="background:var(--grey-bg);">
  <div class="container">
    <div class="section-header centered">
      <span class="section-label">Why Ka'sam?</span>
      <h2 class="section-title">Why Clients Choose Us</h2>
      <div class="divider centered"></div>
    </div>

    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;" class="why-grid">
      <div class="reveal" style="background:var(--white);border-radius:var(--radius-lg);padding:32px;box-shadow:var(--shadow-sm);border-top:4px solid var(--accent);">
        <div style="width:52px;height:52px;background:rgba(232,160,32,.12);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:1.3rem;margin-bottom:18px;">
          <i class="fas fa-award"></i>
        </div>
        <h3 style="font-size:1.15rem;margin-bottom:10px;">Proven Track Record</h3>
        <p style="font-size:.9rem;color:var(--text-body);line-height:1.7;">Over 250 successfully completed projects across Kenya, from small residential builds to large commercial and infrastructure works.</p>
      </div>
      <div class="reveal" style="background:var(--white);border-radius:var(--radius-lg);padding:32px;box-shadow:var(--shadow-sm);border-top:4px solid var(--navy);">
        <div style="width:52px;height:52px;background:rgba(11,31,58,.08);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;color:var(--navy);font-size:1.3rem;margin-bottom:18px;">
          <i class="fas fa-users-cog"></i>
        </div>
        <h3 style="font-size:1.15rem;margin-bottom:10px;">Expert Multidisciplinary Team</h3>
        <p style="font-size:.9rem;color:var(--text-body);line-height:1.7;">Our team includes licensed structural engineers, registered architects, experienced project managers, and skilled artisans across all construction trades.</p>
      </div>
      <div class="reveal" style="background:var(--white);border-radius:var(--radius-lg);padding:32px;box-shadow:var(--shadow-sm);border-top:4px solid var(--accent);">
        <div style="width:52px;height:52px;background:rgba(232,160,32,.12);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:1.3rem;margin-bottom:18px;">
          <i class="fas fa-clock"></i>
        </div>
        <h3 style="font-size:1.15rem;margin-bottom:10px;">On-Time Delivery</h3>
        <p style="font-size:.9rem;color:var(--text-body);line-height:1.7;">We understand that time is money. Our project management processes are designed to ensure timely delivery without compromising quality.</p>
      </div>
      <div class="reveal" style="background:var(--white);border-radius:var(--radius-lg);padding:32px;box-shadow:var(--shadow-sm);border-top:4px solid var(--navy);">
        <div style="width:52px;height:52px;background:rgba(11,31,58,.08);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;color:var(--navy);font-size:1.3rem;margin-bottom:18px;">
          <i class="fas fa-shield-alt"></i>
        </div>
        <h3 style="font-size:1.15rem;margin-bottom:10px;">Safety First</h3>
            <p style="font-size:.9rem;color:var(--text-body);line-height:1.7;">Health and safety is non-negotiable at Ka'sam Construction Enterprise. All our sites operate under strict safety protocols, and our workers are fully trained and equipped with appropriate PPE.</p>
      </div>
      <div class="reveal" style="background:var(--white);border-radius:var(--radius-lg);padding:32px;box-shadow:var(--shadow-sm);border-top:4px solid var(--accent);">
        <div style="width:52px;height:52px;background:rgba(232,160,32,.12);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:1.3rem;margin-bottom:18px;">
          <i class="fas fa-hand-holding-usd"></i>
        </div>
        <h3 style="font-size:1.15rem;margin-bottom:10px;">Transparent Pricing</h3>
        <p style="font-size:.9rem;color:var(--text-body);line-height:1.7;">No hidden costs. We provide detailed, itemized quotations and maintain open communication about project budgets throughout every phase of construction.</p>
      </div>
      <div class="reveal" style="background:var(--white);border-radius:var(--radius-lg);padding:32px;box-shadow:var(--shadow-sm);border-top:4px solid var(--navy);">
        <div style="width:52px;height:52px;background:rgba(11,31,58,.08);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;color:var(--navy);font-size:1.3rem;margin-bottom:18px;">
          <i class="fas fa-leaf"></i>
        </div>
        <h3 style="font-size:1.15rem;margin-bottom:10px;">Sustainable Building</h3>
        <p style="font-size:.9rem;color:var(--text-body);line-height:1.7;">We incorporate eco-friendly materials and sustainable building practices wherever possible, helping clients reduce their environmental footprint and energy costs.</p>
      </div>
    </div>
  </div>
</section>


<!-- ── TEAM ──────────────────────────────────────────────────── -->
<section class="team-section section-pad">
  <div class="container">
    <div class="section-header centered">
      <span class="section-label">The People</span>
      <h2 class="section-title">Meet Our Expert Team</h2>
      <div class="divider centered"></div>
      <p class="section-sub">
        Behind every great project is an exceptional team. Meet the dedicated professionals
        who bring expertise, passion, and precision to every Ka'sam Construction Enterprise project.
      </p>
    </div>

    <div class="team-grid">
      <% if (typeof teamMembers !== 'undefined' && teamMembers && teamMembers.length > 0) { %>
        <% teamMembers.forEach(function(member) { %>
        <div class="team-card reveal">
          <div class="team-photo">
            <img src="<%= member.photo_url %>" alt="<%= member.name %>" loading="lazy" decoding="async" />
          </div>
          <div class="team-body">
            <h3><%= member.name %></h3>
            <div class="team-role"><%= member.role %></div>
            <% if (member.phone) { %>
              <div class="team-contact">📞 <%= member.phone %></div>
            <% } %>
            <p><%= member.bio || 'A dedicated professional contributing excellence to every Ka\'sam Construction Enterprise project.' %></p>
            <div class="team-socials">
              <% if (member.linkedin) { %>
              <a href="<%= member.linkedin %>" class="team-social-btn" target="_blank" rel="noopener noreferrer"><i class="fab fa-linkedin-in"></i></a>
              <% } %>
              <% if (member.email) { %>
              <a href="mailto:<%= member.email %>" class="team-social-btn"><i class="fas fa-envelope"></i></a>
              <% } %>
              <% if (member.phone) { %>
              <a href="tel:<%= member.phone %>" class="team-social-btn"><i class="fas fa-phone"></i></a>
              <% } %>
            </div>
          </div>
        </div>
        <% }); %>
      <% } else { %>
        <!-- Static team members -->

        <div class="team-card reveal">
          <div class="team-photo">
            <img src="/media/team/maxwell.jfif" alt="Maxwell Okoth" loading="lazy" decoding="async" />
          </div>
          <div class="team-body">
            <h3>Maxwell Okoth</h3>
            <div class="team-role">Architect</div>
            <p>Maxwell is a creative and technically proficient architect who combines innovative design with practical construction knowledge, delivering spaces that are both beautiful and functional.</p>
            <div class="team-socials">
              <a href="#" class="team-social-btn"><i class="fab fa-linkedin-in"></i></a>
              <a href="mailto:maxwell@apexconstruction.co.ke" class="team-social-btn"><i class="fas fa-envelope"></i></a>
            </div>
          </div>
        </div>

        <div class="team-card reveal">
          <div class="team-photo">
            <img src="/media/team/ronex.jfif" alt="Ronex" loading="lazy" decoding="async" />
          </div>
          <div class="team-body">
            <h3>Ronex</h3>
            <div class="team-role">Roofing Specialist</div>
            <p>Ronex leads our roofing division with expertise in all roofing systems including iron sheets, tiles, flat roofs, and specialized waterproof membranes. Known for precision installation and durability.</p>
            <div class="team-socials">
              <a href="#" class="team-social-btn"><i class="fab fa-linkedin-in"></i></a>
              <a href="mailto:roofing@apexconstruction.co.ke" class="team-social-btn"><i class="fas fa-envelope"></i></a>
            </div>
          </div>
        </div>

      <% } %>
    </div>
  </div>
</section>


<!-- ── CTA ───────────────────────────────────────────────────── -->
<section class="cta-banner">
  <div class="container">
    <div class="cta-inner">
      <div class="cta-text">
        <h2>Join Our Growing Team</h2>
        <p>We are always looking for talented, passionate construction professionals to join Ka'sam Construction Enterprise. Get in touch to explore career opportunities.</p>
      </div>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-primary">
          <i class="fas fa-envelope"></i> Get In Touch
        </a>
        <a href="tel:0714712531" class="btn btn-outline">
          <i class="fas fa-phone"></i> 0714 712 531
        </a>
      </div>
    </div>
  </div>
</section>
