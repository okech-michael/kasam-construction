<!-- ── HERO ──────────────────────────────────────────────────── -->
<section class="hero">
  <div class="hero-slides">
    <div class="hero-slide hero-slide-1"></div>
    <div class="hero-slide hero-slide-2"></div>
    <div class="hero-slide hero-slide-3"></div>
  </div>
  <div class="hero-overlay"></div>

  <div class="hero-content">
    <div class="hero-inner">
      <div class="hero-badge">
        <span></span>
        Kenya's Trusted Construction Partner
      </div>

      <h1 class="hero-title">
        Building the Future<br>
        with <em>Excellence</em>
      </h1>

      <p class="hero-sub">
        Ka'sam Construction Enterprise delivers world-class construction, renovation,
        and infrastructure solutions across Kenya — on time, on budget, and built to last.
      </p>

      <div class="hero-actions">
        <a href="/services" class="btn btn-primary">
          <i class="fas fa-hard-hat"></i> View Our Services
        </a>
        <a href="/contact" class="btn btn-outline">
          <i class="fas fa-calendar-check"></i> Book Consultation
        </a>
      </div>

      <div class="hero-info">
        <div class="hero-info-item">
          <i class="fas fa-phone-alt"></i>
          <a href="tel:0714712531">0714 712 531</a>
        </div>
        <div class="hero-info-item">
          <i class="fas fa-envelope"></i>
          <a href="mailto:info@kasamenterprises.com">info@kasamenterprises.com</a>
        </div>
        <div class="hero-info-item">
          <i class="fas fa-map-marker-alt"></i>
          <span>Nyamasaria Shopping Centre, Kisumu</span>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-indicators">
    <div class="hero-dot active" data-slide="0"></div>
    <div class="hero-dot" data-slide="1"></div>
    <div class="hero-dot" data-slide="2"></div>
  </div>

  <div class="hero-scroll">
    <span>Scroll</span>
    <div class="hero-scroll-line"></div>
  </div>
</section>


<!-- ── STATS BAR ─────────────────────────────────────────────── -->
<section class="stats-bar">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item reveal">
        <div class="stat-number" data-target="250" data-suffix="+">250+</div>
        <div class="stat-label">Projects Completed</div>
      </div>
      <div class="stat-item reveal">
        <div class="stat-number" data-target="15" data-suffix="+">15+</div>
        <div class="stat-label">Years Experience</div>
      </div>
      <div class="stat-item reveal">
        <div class="stat-number" data-target="120" data-suffix="+">120+</div>
        <div class="stat-label">Happy Clients</div>
      </div>
      <div class="stat-item reveal">
        <div class="stat-number" data-target="50" data-suffix="+">50+</div>
        <div class="stat-label">Expert Professionals</div>
      </div>
    </div>
  </div>
</section>


<!-- ── COMPANY INTRO ─────────────────────────────────────────── -->
