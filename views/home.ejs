          Our multidisciplinary team of engineers, architects, planners, and skilled tradespeople
          work collaboratively to bring your vision to life. Whether it's a residential home,
          commercial complex, or major infrastructure project, we deliver results that stand the test of time.
        </p>

        <div class="intro-features">
          <div class="intro-feature">
            <div class="intro-feature-icon"><i class="fas fa-shield-alt"></i></div>
            <div class="intro-feature-text">
              <strong>Licensed &amp; Insured</strong>
              <span>Fully certified professionals</span>
            </div>
          </div>
          <div class="intro-feature">
            <div class="intro-feature-icon"><i class="fas fa-award"></i></div>
            <div class="intro-feature-text">
              <strong>Award-Winning Quality</strong>
              <span>Recognized for excellence</span>
            </div>
          </div>
          <div class="intro-feature">
            <div class="intro-feature-icon"><i class="fas fa-clock"></i></div>
            <div class="intro-feature-text">
              <strong>On-Time Delivery</strong>
              <span>We respect your deadlines</span>
            </div>
          </div>
          <div class="intro-feature">
            <div class="intro-feature-icon"><i class="fas fa-handshake"></i></div>
            <div class="intro-feature-text">
              <strong>Trusted Partnerships</strong>
              <span>Long-term client relationships</span>
            </div>
          </div>
        </div>

        <a href="/about" class="btn btn-navy">
          Learn About Us <i class="fas fa-arrow-right"></i>
        </a>
      </div>

      <div class="intro-image-wrap reveal">
        <div class="intro-img-main">
          <img src="/static/images/crane_at_work.jfif"
               alt="Ka'sam Construction Enterprise at work" loading="lazy" decoding="async" />
        </div>
        <div class="intro-badge-box">
          <div class="num">15+</div>
          <div class="label">Years of Building Excellence</div>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ── SERVICES PREVIEW ──────────────────────────────────────── -->
<section class="services-preview section-pad">
  <div class="container">
    <div class="section-header centered">
      <span class="section-label">What We Do</span>
      <h2 class="section-title">Our Core Services</h2>
      <div class="divider centered"></div>
      <p class="section-sub">
        From ground-breaking to finishing touches, we provide a comprehensive range of
        construction and infrastructure services tailored to your needs.
      </p>
    </div>

    <div class="services-grid">
      <% if (typeof featuredServices !== 'undefined' && featuredServices && featuredServices.length > 0) { %>
        <% featuredServices.forEach(function(service) { %>
        <div class="service-card reveal">
          <div class="service-card-img">
            <img src="<%= service.image_url %>" alt="<%= service.title %>" loading="lazy" decoding="async" />
          </div>
          <div class="service-card-body">
            <div class="service-card-icon">
              <i class="fas <%= service.icon || 'fa-tools' %>"></i>
            </div>
            <h3><%= service.title %></h3>
            <p><%= service.description.substring(0, 150) %>...</p>
            <a href="/services" class="service-link">
              Learn More <i class="fas fa-arrow-right"></i>
            </a>
          </div>
        </div>
        <% }); %>
      <% } else { %>
        <!-- Static fallback services -->
        <div class="service-card reveal">
          <div class="service-card-img">
            <img src="/static/images/civil-and-infrastructure-works.webp" alt="Service placeholder" loading="lazy" decoding="async" />
          </div>
          <div class="service-card-body">
            <div class="service-card-icon">
              <i class="fas fa-tools"></i>
            </div>
            <h3>General Construction</h3>
            <p>Full-scale residential and commercial construction projects delivered with precision and quality craftsmanship.</p>
            <a href="/services" class="service-link">
              Learn More <i class="fas fa-arrow-right"></i>
            </a>
          </div>
        </div>

        <div class="service-card reveal">
          <div class="service-card-img">
            <img src="/static/images/design-mechanical-electrical-works.jfif" alt="Service placeholder" loading="lazy" decoding="async" />
          </div>
          <div class="service-card-body">
            <div class="service-card-icon">
              <i class="fas fa-tools"></i>
            </div>
            <h3>Design &amp; Planning</h3>
            <p>Expert architectural design and project planning services to bring your vision to life before the first brick is laid.</p>
            <a href="/services" class="service-link">
              Learn More <i class="fas fa-arrow-right"></i>
            </a>
          </div>
        </div>

        <div class="service-card reveal">
          <div class="service-card-img">
            <img src="/static/images/renovation-work.jfif" alt="Service placeholder" loading="lazy" decoding="async" />
          </div>
          <div class="service-card-body">
            <div class="service-card-icon">
              <i class="fas fa-tools"></i>
            </div>
            <h3>Project Management</h3>
            <p>End-to-end project oversight ensuring timely delivery, cost control, and quality standards throughout construction.</p>
            <a href="/services" class="service-link">
              Learn More <i class="fas fa-arrow-right"></i>
            </a>
          </div>
        </div>

        <div class="service-card reveal">
          <div class="service-card-img">
            <img src="/static/images/storey-building.jfif" alt="Service placeholder" loading="lazy" decoding="async" />
          </div>
          <div class="service-card-body">
            <div class="service-card-icon">
              <i class="fas fa-tools"></i>
            </div>
            <h3>Renovation &amp; Remodeling</h3>
            <p>Transform existing structures with modern upgrades, interior remodeling, and complete renovation services.</p>
            <a href="/services" class="service-link">
              Learn More <i class="fas fa-arrow-right"></i>
            </a>
          </div>
        </div>

        <div class="service-card reveal">
          <div class="service-card-img">
            <img src="/static/images/general-construction.jfif" alt="Service placeholder" loading="lazy" decoding="async" />
          </div>
          <div class="service-card-body">
            <div class="service-card-icon">
              <i class="fas fa-tools"></i>
            </div>
            <h3>Civil &amp; Infrastructure</h3>
            <p>Roads, drainage systems, bridges, and public infrastructure built to the highest engineering standards.</p>
            <a href="/services" class="service-link">
              Learn More <i class="fas fa-arrow-right"></i>
            </a>
          </div>
        </div>

        <div class="service-card reveal">
          <div class="service-card-img">
            <img src="/static/images/Nyalenda-estate.jfif" alt="Service placeholder" loading="lazy" decoding="async" />
          </div>
          <div class="service-card-body">
            <div class="service-card-icon">
              <i class="fas fa-tools"></i>
            </div>
            <h3>MEP Services</h3>
            <p>Complete mechanical, electrical, and plumbing installations handled by certified, experienced technicians.</p>
            <a href="/services" class="service-link">
              Learn More <i class="fas fa-arrow-right"></i>
            </a>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>


<!-- ── PROJECTS PREVIEW ──────────────────────────────────────── -->
<section class="projects-preview section-pad" style="background:var(--grey-bg);">
  <div class="container">
    <div class="section-header centered">
      <span class="section-label">Our Portfolio</span>
      <h2 class="section-title">Featured Projects</h2>
      <div class="divider centered"></div>
      <p class="section-sub">
        Browse a selection of our most impressive completed and ongoing projects,
        showcasing our expertise across diverse construction sectors.
      </p>
    </div>

    <div class="projects-grid">
      <% if (typeof featuredProjects !== 'undefined' && featuredProjects && featuredProjects.length > 0) { %>
        <% featuredProjects.forEach(function(project, index) { %>
        <div class="project-card reveal">
          <div class="project-card-img">
            <% if (project.image) { %>
              <img src="<%= project.image %>" alt="<%= project.title %>" loading="lazy" decoding="async" />
            <% } else { %>
              <img src="/static/images/genral-construction.jfif" alt="<%= project.title %>" loading="lazy" decoding="async" />
            <% } %>
          </div>
          <div class="project-card-body">
            <span class="project-status <%= project.status === 'Completed' ? 'status-completed' : 'status-ongoing' %>"><%= project.status %></span>
            <h3><%= project.title %></h3>
            <p><%= project.description %></p>
            <div class="project-meta">
              <% if (project.location) { %><span><i class="fas fa-map-marker-alt"></i> <%= project.location %></span><% } %>
              <% if (project.year) { %><span><i class="fas fa-calendar"></i> <%= project.year %></span><% } %>
            </div>
          </div>
        </div>
        <% }); %>
      <% } %>
    </div>

    <div class="text-center" style="margin-top:40px;">
      <a href="/projects" class="btn btn-navy">
        View All Projects <i class="fas fa-arrow-right"></i>
      </a>
    </div>
  </div>
</section>


<!-- ── TESTIMONIALS ──────────────────────────────────────────── -->
<section class="testimonials-section section-pad">
  <div class="container">
    <div class="section-header centered">
      <span class="section-label">What Clients Say</span>
      <h2 class="section-title">Client Testimonials</h2>
      <div class="divider centered"></div>
    </div>

    <div class="testimonials-grid">
      <% if (typeof testimonials !== 'undefined' && testimonials && testimonials.length > 0) { %>
        <% testimonials.forEach(function(testimonial) { %>
        <div class="testimonial-card reveal">
          <div class="testimonial-stars">
            <% for (let i = 0; i < (testimonial.rating || 5); i++) { %>
              <i class="fas fa-star"></i>
            <% } %>
          </div>
          <p class="testimonial-text">"<%= testimonial.message %>"</p>
          <div class="testimonial-author">
            <div class="testimonial-avatar">
              <% if (testimonial.photo) { %>
                <img src="<%= testimonial.photo %>" alt="<%= testimonial.client_name %>" loading="lazy" decoding="async" />
              <% } else { %>
                <div class="avatar-placeholder"><%= testimonial.client_name.charAt(0) %></div>
              <% } %>
            </div>
            <div class="testimonial-meta">
              <h4><%= testimonial.client_name %></h4>
              <p><%= testimonial.client_role %> at <%= testimonial.client_company %></p>
            </div>
          </div>
        </div>
        <% }); %>
      <% } %>
    </div>
  </div>
</section>


