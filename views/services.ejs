<!-- ── PAGE HERO ─────────────────────────────────────────────── -->
<section class="page-hero">
  <div class="container page-hero-inner">
    <div class="breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <span style="color:rgba(255,255,255,.8);">Services</span>
    </div>
    <h1>Our Services</h1>
    <p>Comprehensive construction and infrastructure solutions delivered with excellence, precision, and professionalism across Kenya.</p>
  </div>
</section>


<!-- ── SERVICES INTRO ──────────────────────────────────────────── -->
<section class="section-pad-sm" style="background:var(--grey-bg);">
  <div class="container" style="text-align:center;">
    <span class="section-label">What We Offer</span>
    <h2 class="section-title" style="max-width:640px;margin:0 auto 14px;">
      End-to-End Construction Solutions
    </h2>
    <div class="divider centered"></div>
    <p style="color:var(--text-body);max-width:620px;margin:0 auto;font-size:1.02rem;">
      From initial design and planning to final finishing touches, our skilled team handles
      every aspect of your construction project. Explore our full range of services below.
    </p>
  </div>
</section>


<!-- ── ALL SERVICES ──────────────────────────────────────────── -->
<section class="section-pad" style="background:var(--white);">
  <div class="container">
    <% if (typeof services !== 'undefined' && services && services.length > 0) { %>
    <div class="services-full-grid">
      <% services.forEach(function(service, index) { %>
      <div class="service-full-card reveal">
        <div class="service-full-img">
          <img src="<%= service.image_url %>" alt="<%= service.title %>" loading="lazy" decoding="async" />
        </div>
        <div class="service-full-body">
          <span class="service-num">Service <%= (index + 1).toString().padStart(2, '0') %></span>
          <h3><%= service.title %></h3>
          <p><%= service.description %></p>
        </div>
      </div>
      <% }); %>
    </div>
    <% } else { %>
    <!-- Static services (shown when DB is empty) -->
    <div class="services-full-grid">

      <div class="service-full-card reveal">
        <div class="service-full-img" style="background:linear-gradient(135deg,#0b1f3a,#1e3f70);">
          <i class="fas fa-building" style="color:rgba(255,255,255,.2);font-size:4rem;"></i>
        </div>
        <div class="service-full-body">
          <span class="service-num">Service 01</span>
          <h3>General Construction Services</h3>
          <p>Construction services for residential, commercial, and institutional projects, including site preparation, foundations, structural work, and external works.</p>
        </div>
      </div>

      <div class="service-full-card reveal">
        <div class="service-full-img" style="background:linear-gradient(135deg,#142d52,#0b1f3a);">
          <i class="fas fa-drafting-compass" style="color:rgba(255,255,255,.2);font-size:4rem;"></i>
        </div>
        <div class="service-full-body">
          <span class="service-num">Service 02</span>
          <h3>Design &amp; Planning</h3>
          <p>Design and planning support may include concept development, architectural drawings, structural plans, and guidance on approval processes, depending on project requirements.</p>
        </div>
      </div>

      <div class="service-full-card reveal">
        <div class="service-full-img" style="background:linear-gradient(135deg,#1e3f70,#142d52);">
          <i class="fas fa-tasks" style="color:rgba(255,255,255,.2);font-size:4rem;"></i>
        </div>
        <div class="service-full-body">
          <span class="service-num">Service 03</span>
          <h3>Project Management</h3>
          <p>Project coordination may include contractor coordination, procurement support, quality checks, and progress updates based on the agreed project scope.</p>
        </div>
      </div>

      <div class="service-full-card reveal">
        <div class="service-full-img" style="background:linear-gradient(135deg,#0b1f3a,#1e3f70);">
          <i class="fas fa-paint-roller" style="color:rgba(255,255,255,.2);font-size:4rem;"></i>
        </div>
        <div class="service-full-body">
          <span class="service-num">Service 04</span>
          <h3>Renovation &amp; Remodeling</h3>
          <p>Breathe new life into your existing property with our renovation and remodeling services. From complete interior overhauls and room additions to kitchen upgrades, bathroom renovations, and façade improvements, we transform tired spaces into modern, functional environments.</p>
        </div>
      </div>

      <div class="service-full-card reveal">
        <div class="service-full-img" style="background:linear-gradient(135deg,#142d52,#0b1f3a);">
          <i class="fas fa-road" style="color:rgba(255,255,255,.2);font-size:4rem;"></i>
        </div>
        <div class="service-full-body">
          <span class="service-num">Service 05</span>
          <h3>Civil &amp; Infrastructure Works</h3>
          <p>Civil and infrastructure services may include roads, bridges, drainage systems, water supply networks, and public utilities. Project scope and applicable requirements are discussed for each project.</p>
        </div>
      </div>

      <div class="service-full-card reveal">
        <div class="service-full-img" style="background:linear-gradient(135deg,#1e3f70,#142d52);">
          <i class="fas fa-layer-group" style="color:rgba(255,255,255,.2);font-size:4rem;"></i>
        </div>
        <div class="service-full-body">
          <span class="service-num">Service 06</span>
          <h3>Foundation &amp; Structural Works</h3>
          <p>A strong structure begins with a solid foundation. Our structural engineering team handles soil assessment, foundation design, deep piling, reinforced concrete works, and structural steel fabrication — ensuring every building we construct stands firmly for generations.</p>
        </div>
      </div>

      <div class="service-full-card reveal">
        <div class="service-full-img" style="background:linear-gradient(135deg,#0b1f3a,#1e3f70);">
          <i class="fas fa-palette" style="color:rgba(255,255,255,.2);font-size:4rem;"></i>
        </div>
        <div class="service-full-body">
          <span class="service-num">Service 07</span>
          <h3>Finishing Services</h3>
          <p>Our finishing team delivers premium interior and exterior finishes including plastering, tiling, painting, ceiling installation, flooring, joinery, and decorative elements. Every finish is executed with meticulous attention to detail for a truly polished result.</p>
        </div>
      </div>

      <div class="service-full-card reveal">
        <div class="service-full-img" style="background:linear-gradient(135deg,#142d52,#0b1f3a);">
          <i class="fas fa-bolt" style="color:rgba(255,255,255,.2);font-size:4rem;"></i>
        </div>
        <div class="service-full-body">
          <span class="service-num">Service 08</span>
          <h3>Mechanical, Electrical &amp; Plumbing (MEP)</h3>
          <p>Our MEP services include mechanical, electrical, and plumbing systems such as power distribution, wiring, lighting, water supply, drainage, HVAC, fire suppression systems, and solar energy integration.</p>
        </div>
      </div>

      <div class="service-full-card reveal">
        <div class="service-full-img">
          <img src="/static/images/general-construction.jfif" alt="Landscaping & External Works" loading="lazy" decoding="async" />
        </div>
        <div class="service-full-body">
          <span class="service-num">Service 09</span>
          <h3>Landscaping &amp; External Works</h3>
          <p>Enhance the appeal, usability, and resilience of your property with our full landscaping and external works service. We deliver garden design, turfing, ornamental planting, walkways, driveways, retaining walls, stormwater drainage, irrigation, outdoor lighting, boundary fencing, and hardscaping—all tailored for residential and commercial developments.</p>
        </div>
      </div>

      <div class="service-full-card reveal">
        <div class="service-full-img" style="background:linear-gradient(135deg,#0b1f3a,#1e3f70);">
          <i class="fas fa-wrench" style="color:rgba(255,255,255,.2);font-size:4rem;"></i>
        </div>
        <div class="service-full-body">
          <span class="service-num">Service 10</span>
          <h3>Maintenance &amp; Facility Management</h3>
          <p>Protect your investment with our professional property maintenance services. We offer scheduled maintenance programs, emergency repairs, general facility management, and preventive upkeep for buildings of all types — keeping your assets in peak condition year-round.</p>
        </div>
      </div>

      <div class="service-full-card reveal">
        <div class="service-full-img" style="background:linear-gradient(135deg,#142d52,#0b1f3a);">
          <i class="fas fa-star" style="color:rgba(255,255,255,.2);font-size:4rem;"></i>
        </div>
        <div class="service-full-body">
          <span class="service-num">Service 11</span>
          <h3>Specialized Services</h3>
          <p>Beyond standard construction, we offer specialized solutions including waterproofing, noise insulation, green building certification support, post-tensioning, construction of industrial facilities, and bespoke structural solutions for unique or complex architectural requirements.</p>
        </div>
      </div>

    </div>
    <% } %>
  </div>
</section>


<!-- ── CTA ───────────────────────────────────────────────────── -->
<section class="cta-banner">
  <div class="container">
    <div class="cta-inner">
      <div class="cta-text">
        <h2>Need a Custom Solution?</h2>
        <p>Contact us to discuss your project requirements and request a consultation or proposal.</p>
      </div>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-primary">
          <i class="fas fa-calendar-check"></i> Book Consultation
        </a>
        <a href="tel:0714712531" class="btn btn-outline">
          <i class="fas fa-phone"></i> 0714 712 531
        </a>
      </div>
    </div>
  </div>
</section>
