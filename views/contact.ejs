<script>
  // Form tab switching
  document.querySelectorAll('.forms-tab-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const tabName = this.getAttribute('data-tab');
      
      // Hide all form panels
      document.querySelectorAll('.form-panel').forEach(panel => {
        panel.classList.remove('active');
      });
      
      // Remove active class from all buttons
      document.querySelectorAll('.forms-tab-btn').forEach(b => {
        b.classList.remove('active');
      });
      
      // Show selected panel and mark button as active
      document.getElementById(tabName).classList.add('active');
      this.classList.add('active');
    });
  });

  // Activate the booking tab if hash is #book
  if (window.location.hash === '#book') {
    document.querySelectorAll('.forms-tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.form-panel').forEach(p => p.classList.remove('active'));
    document.querySelector('[data-tab="booking-form-panel"]')?.classList.add('active');
    document.getElementById('booking-form-panel')?.classList.add('active');
  }
</script>
